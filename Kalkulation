                        <div class="flex justify-between"><span>Herstellkosten:</span><strong id="out_b_herstell" class="text-anthrazit">0,00 €</strong></div>
                        <div class="text-[11px] text-indigo-600 mt-0.5">📐 <em>Formel:</em> (Selbstkosten - SEKV) / (1 + (VwGK + VertGK) / 100)</div>
                    </div>
                    <div class="border-t pt-2">
                        <div class="flex justify-between"><span>Fertigungskosten:</span><strong id="out_b_fert" class="text-anthrazit">0,00 €</strong></div>
                        <div class="text-[11px] text-indigo-600 mt-0.5">📐 <em>Formel:</em> (Fertigungslöhne * (1 + FGK / 100)) + SEKF</div>
                    </div>
                    <div class="border-t pt-2">
                        <div class="flex justify-between"><span>Materialkosten:</span><strong id="out_b_mat" class="text-anthrazit">0,00 €</strong></div>
                        <div class="text-[11px] text-indigo-600 mt-0.5">📐 <em>Formel:</em> Herstellkosten - Fertigungskosten</div>
                    </div>
                    <div class="border-t pt-2 text-sm font-bold text-green-700">
                        <div class="flex justify-between"><span>Max. Materialeinzelkosten:</span><strong id="out_b_mek">0,00 €</strong></div>
                        <div class="text-[11px] text-indigo-600 font-normal mt-0.5">📐 <em>Formel:</em> Materialkosten / (1 + MGK / 100)</div>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <script>
        const fmt = (num) => new Intl.NumberFormat("de-DE", { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num) + " €";

        function switchTab(tab) {
            ["marketing", "forward", "backward"].forEach(t => {
                document.getElementById("tab-" + t).classList.add("hidden");
                document.getElementById("tab-btn-" + t).className = "px-3 py-1.5 rounded-md font-bold text-gray-300 transition";
            });
            document.getElementById("tab-" + tab).classList.remove("hidden");
            document.getElementById("tab-btn-" + tab).className = "px-3 py-1.5 rounded-md font-bold bg-kaercher text-anthrazit transition";
        }

        function calcWerbeplanBudget() {
            const online = parseFloat(document.getElementById("wp_m_online").value) || 0;
            const print = parseFloat(document.getElementById("wp_m_print").value) || 0;
            const messe = parseFloat(document.getElementById("wp_m_messe").value) || 0;
            const sonst = parseFloat(document.getElementById("wp_m_sonst").value) || 0;
            const total = online + print + messe + sonst;
            document.getElementById("wp_total_budget").innerText = fmt(total);
            // Sync with controlling budget input automatically
            document.getElementById("m_komm").value = total;
            document.getElementById("p_komm_budget").value = total;
            calcMarketing();
            calc4Ps();
        }

        function calc4Ps() {
            const prod = parseFloat(document.getElementById("p_prod").value) || 0;
            const preis = parseFloat(document.getElementById("p_preis").value) || 0;
            const dist = parseFloat(document.getElementById("p_dist").value) || 0;
            const komm = parseFloat(document.getElementById("p_komm_budget").value) || 0;
            const total = prod + preis + dist + komm;
            document.getElementById("res_4ps_total").innerText = fmt(total);
        }

        function calcMarketing() {
            const umsatz = parseFloat(document.getElementById("m_umsatz").value) || 1;
            const komm = parseFloat(document.getElementById("m_komm").value) || 0;
            const db = (parseFloat(document.getElementById("m_db").value) || 0) / 100;
            const mehr = parseFloat(document.getElementById("m_mehr").value) || 0;

            const anteil = (komm / umsatz) * 100;
            const gewinn = (mehr * db) - komm;
            const breakEven = db > 0 ? komm / db : 0;

            document.getElementById("res_anteil").innerText = anteil.toFixed(1).replace(".", ",") + "%";
            document.getElementById("res_gewinn").innerText = fmt(gewinn);
            document.getElementById("res_break").innerText = fmt(breakEven);
        }

        function calcForward() {
            const mek = parseFloat(document.getElementById("f_mek").value) || 0;
            const mgkS = parseFloat(document.getElementById("f_mgk").value) || 0;
            const flo = parseFloat(document.getElementById("f_flo").value) || 0;
            const fgkS = parseFloat(document.getElementById("f_fgk").value) || 0;
            const sekf = parseFloat(document.getElementById("f_sekf").value) || 0;
            const vwgkS = parseFloat(document.getElementById("f_vwgk").value) || 0;
            const vertgkS = parseFloat(document.getElementById("f_vertgk").value) || 0;
            const sekv = parseFloat(document.getElementById("f_sekv").value) || 0;
            const gewS = parseFloat(document.getElementById("f_gewinn").value) || 0;
            const skontoS = parseFloat(document.getElementById("f_skonto").value) || 0;
            const provS = parseFloat(document.getElementById("f_prov").value) || 0;
            const rabattS = parseFloat(document.getElementById("f_rabatt").value) || 0;

            const mgk = mek * (mgkS / 100);
            const matKosten = mek + mgk;
            const zwischenFert = flo + (flo * (fgkS / 100));
            const fertKostenNur = zwischenFert + sekf;
            const herstellKosten = matKosten + fertKostenNur;

            const vwgk = herstellKosten * (vwgkS / 100);
            const vertgk = herstellKosten * (vertgkS / 100);
            const selbstkosten = herstellKosten + vwgk + vertgk + sekv;

            const gewinn = selbstkosten * (gewS / 100);
            const barVP = selbstkosten + gewinn;

            const prozentBar = 100 - skontoS - provS;
            const zielVP = prozentBar > 0 ? barVP / (prozentBar / 100) : 0;
            const listenVP = (100 - rabattS) > 0 ? zielVP / ((100 - rabattS) / 100) : 0;

            document.getElementById("out_f_mat").innerText = fmt(matKosten);
            document.getElementById("out_f_fert").innerText = fmt(fertKostenNur);
            document.getElementById("out_f_herstell").innerText = fmt(herstellKosten);
            document.getElementById("out_f_selbst").innerText = fmt(selbstkosten);
            document.getElementById("out_f_bar").innerText = fmt(barVP);
            document.getElementById("out_f_ziel").innerText = fmt(zielVP);
            document.getElementById("out_f_listen").innerText = fmt(listenVP);
        }

        function calcBackward() {
            const listen = parseFloat(document.getElementById("b_listen").value) || 0;
            const rabattS = parseFloat(document.getElementById("b_rabatt").value) || 0;
            const provS = parseFloat(document.getElementById("b_prov").value) || 0;
            const skontoS = parseFloat(document.getElementById("b_skonto").value) || 0;
            const gewS = parseFloat(document.getElementById("b_gewinn").value) || 0;
            const vwgkS = parseFloat(document.getElementById("b_vwgk").value) || 0;
            const vertgkS = parseFloat(document.getElementById("b_vertgk").value) || 0;
            const sekv = parseFloat(document.getElementById("b_sekv").value) || 0;
            const flo = parseFloat(document.getElementById("b_flo").value) || 0;
            const fgkS = parseFloat(document.getElementById("b_fgk").value) || 0;
            const sekf = parseFloat(document.getElementById("b_sekf").value) || 0;
            const mgkS = parseFloat(document.getElementById("b_mgk").value) || 0;

            const zielVP = listen * (1 - rabattS / 100);
            const barVP = zielVP * (1 - (provS + skontoS) / 100);
            const selbstkosten = barVP / (1 + gewS / 100);
            const herstellKosten = (selbstkosten - sekv) / (1 + (vwgkS + vertgkS) / 100);
            const fertKostenTotal = flo * (1 + fgkS / 100) + sekf;
            const matKosten = herstellKosten - fertKostenTotal;
            const mek = matKosten / (1 + mgkS / 100);

            document.getElementById("out_b_ziel").innerText = fmt(zielVP);
            document.getElementById("out_b_bar").innerText = fmt(barVP);
            document.getElementById("out_b_selbst").innerText = fmt(selbstkosten);
            document.getElementById("out_b_herstell").innerText = fmt(herstellKosten);
            document.getElementById("out_b_fert").innerText = fmt(fertKostenTotal);
            document.getElementById("out_b_mat").innerText = fmt(matKosten);
            document.getElementById("out_b_mek").innerText = fmt(mek);
        }

        document.querySelectorAll(".wp-budget").forEach(el => el.addEventListener("input", calcWerbeplanBudget));
        document.querySelectorAll(".p-calc").forEach(el => el.addEventListener("input", calc4Ps));
        document.querySelectorAll(".m-calc").forEach(el => el.addEventListener("input", calcMarketing));
        document.querySelectorAll(".f-calc").forEach(el => el.addEventListener("input", calcForward));
        document.querySelectorAll(".b-calc").forEach(el => el.addEventListener("input", calcBackward));

        calcWerbeplanBudget();
        calc4Ps();
        calcMarketing();
        calcForward();
        calcBackward();
    </script>
</body>
</html>"""
